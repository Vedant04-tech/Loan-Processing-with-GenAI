# ── Option 1: Atlas (cloud) — just set this one line ──
# MONGO_URI=mongodb+srv://trace_user:YOUR_PASSWORD@tracecluster.xxxxx.mongodb.net/trace_db?retryWrites=true&w=majority

# ── Option 2: Local Docker (default) ──
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=trace_user
MONGO_PASSWORD=trace_password
MONGO_DB=trace_db
